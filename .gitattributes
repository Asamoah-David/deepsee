# Normalize line endings. The repository is worked on from Windows, but the
# Docker images, CI runners and Railway builds are Linux, so a stray CRLF in a
# shell script or Dockerfile is a real failure mode. Force LF in the repo and
# let Git handle the working tree.

* text=auto eol=lf

# Explicit LF for files where CRLF actively breaks execution.
*.sh            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.json          text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.js            text eol=lf
*.jsx           text eol=lf
*.mjs           text eol=lf
*.css           text eol=lf
*.md            text eol=lf

# PowerShell scripts must keep CRLF; Windows PowerShell 5.1 mis-parses LF here.
*.ps1           text eol=crlf
*.psm1          text eol=crlf

# Binary assets must never be line-ending translated.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.exe           binary
*.dll           binary
*.msi           binary
*.zip           binary

# Keep lockfile diffs reviewable and prevent merge noise.
pnpm-lock.yaml  -diff linguist-generated