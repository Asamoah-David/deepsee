# Copy to docker/.env before running `docker compose -f docker/docker-compose.yml up -d`.
#
# Compose does NOT read apps/web/.env.local. This file configures the containers;
# apps/web/.env.local configures the Next.js process running on your host.

# --- PostgreSQL container ---
POSTGRES_USER=deepsee
# Required. There is intentionally no default: a shared development password
# baked into a committed file is how "temporary" credentials reach production.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=deepsee
POSTGRES_PORT=5432

# --- Relay container ---
RELAY_PORT=8080
LOG_LEVEL=debug

# Required by the relay to verify device and admin JWTs. In a real Supabase
# project this is Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=change-me-local-only-at-least-32-characters